{
  "name": "@neelshha/ui",
  "version": "0.1.0",
  "description": "Interface components by Neel Shah",
  "homepage": "https://ui.neelshha.com",
  "license": "MIT",
  "type": "module",
  "bin": {
    "ns": "./bin/ns.js"
  },
