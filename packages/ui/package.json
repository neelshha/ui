    "./tokens.css": "./src/tokens.css"
  },
  "files": ["src", "bin", "registry"],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "registry": "node scripts/build-registry.mjs"
  },
  "dependencies": {
    "@neelshha/cli": "0.1.0"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  }
}
